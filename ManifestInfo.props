<Project>
    <PropertyGroup>
        <TSName>BiotrackerExplode</TSName>
        <TSAuthor>Giginss</TSAuthor>
        <TSVersion>1.1.0</TSVersion> <!-- TSVersion empty = GitInfo used instead (if available; check nuget) -->
        <TSWebsite>https://github.com/GreatWyrm/BiotrackerExplodes</TSWebsite>
        <TSDescription>Causes the biotracker to maybe explode. Make sure your biotracking is on point!</TSDescription>
    </PropertyGroup>
    <ItemGroup>
        <!-- Add the Dependency strings here, one for each dependency -->
        <TSDependencyStrings Include="BepInEx-BepInExPack_GTFO-3.2.3" InProject="false" />
    </ItemGroup>
</Project>